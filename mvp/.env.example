# Настройки окружения для MVP 1c-vibe.
# Скопируй в mvp/.env и заполни. НИКОГДА не коммить .env.

# --- Jira ---
# Server/DC: Personal Access Token ИЛИ логин+пароль (Basic).
JIRA_URL=https://jira.example.local
JIRA_TOKEN=
# Если токена нет — пара логин/пароль (для Server/DC логин может быть
# коротким, не email; для Cloud — email + API-токен):
JIRA_USER=
JIRA_PASSWORD=

# --- GitLab ---
GITLAB_URL=https://gitlab.example.local
# Personal Access Token (scope api) или OAuth-токен.
GITLAB_TOKEN=
# Способ передачи: header (PRIVATE-TOKEN, по умолчанию для glpat-*)
# или bearer (Authorization: Bearer, для OAuth-токенов).
# GITLAB_AUTH=

# --- Модель для агента (OpenAI-совместимый endpoint, например LiteLLM) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Прочее ---
# Путь демо-проекта на GitLab (для подсказок, publish берёт его из git remote)
DEMO_PROJECT=rd/1c-ai/1c-vibe-demo
